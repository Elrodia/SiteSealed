{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "node --check server/rails-worker.js"
  },
  "deploy": {
    "preDeployCommand": [
      "npm run db:migrate"
    ],
    "startCommand": "npm run rails:run",
    "restartPolicyType": "NEVER"
  }
}
