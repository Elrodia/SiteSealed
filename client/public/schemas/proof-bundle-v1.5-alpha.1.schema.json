{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://app.sitesealed.com/schemas/proof-bundle-v1.5-alpha.1.schema.json",
  "title": "SiteSealed v1.5-alpha.1 context-bound proof bundle",
  "description": "A SiteSealed receipt for either a context-bound web-camera workflow or a separately labelled imported file. Evidency Sandbox tokens are test-only and browser capture context is not hardware-attested.",
  "type": "object",
  "required": [
    "schemaVersion",
    "bundleVersion",
    "record",
    "receipt",
    "receiptSha256",
    "encryptedOriginal",
    "proofs",
    "proofStatus",
    "operationalAudit",
    "scope"
  ],
  "properties": {
    "schemaVersion": { "const": "sitesealed.proof-bundle.v1.5-alpha.1" },
    "bundleVersion": { "const": "1.5-alpha.1" },
    "record": {
      "type": "object",
      "required": [
        "recordId",
        "recordClass",
        "proofLevel",
        "recordSha256",
        "manifestSha256",
        "evidenceDigest",
        "receivedAt",
        "captureContext"
      ],
      "properties": {
        "recordId": { "type": "string", "pattern": "^SR-[A-Z0-9-]{8,60}$" },
        "recordClass": {
          "enum": ["LIVE_CAPTURE_WEB", "IMPORTED_FILE"]
        },
        "recordSha256": { "$ref": "#/$defs/sha256" },
        "manifestSha256": { "$ref": "#/$defs/sha256" },
        "evidenceDigest": { "$ref": "#/$defs/sha256" },
        "receivedAt": { "type": "string", "format": "date-time" },
        "captureContext": {
          "oneOf": [
            { "$ref": "#/$defs/liveCaptureContext" },
            { "type": "null" }
          ]
        }
      }
    },
    "receipt": {
      "type": "object",
      "required": [
        "schemaVersion",
        "recordId",
        "recordClass",
        "proofLevel",
        "recordSha256",
        "manifestSha256",
        "evidenceDigest",
        "receivedAt"
      ],
      "properties": {
        "schemaVersion": { "const": "sitesealed.receipt.v1.5-alpha.1" },
        "recordClass": {
          "enum": ["LIVE_CAPTURE_WEB", "IMPORTED_FILE"]
        },
        "recordSha256": { "$ref": "#/$defs/sha256" },
        "manifestSha256": { "$ref": "#/$defs/sha256" },
        "evidenceDigest": { "$ref": "#/$defs/sha256" },
        "captureContext": { "$ref": "#/$defs/liveCaptureContext" }
      }
    },
    "receiptSha256": { "$ref": "#/$defs/sha256" },
    "encryptedManifest": { "type": ["object", "null"] },
    "encryptedOriginal": { "type": "object" },
    "proofs": {
      "type": "object",
      "required": ["qualifiedTimestamp", "publicChain"],
      "properties": {
        "qualifiedTimestamp": {
          "type": "object",
          "required": ["state", "environment", "legalUse"],
          "properties": {
            "state": {
              "enum": ["NOT_ISSUED", "SANDBOX_TOKEN_ISSUED", "TOKEN_ISSUED"]
            },
            "environment": { "enum": ["SANDBOX", "PRODUCTION"] },
            "legalUse": { "type": "boolean" },
            "hashedMessage": {
              "type": ["string", "null"],
              "pattern": "^[a-f0-9]{64}$"
            },
            "signatureVerification": {
              "enum": ["NOT_AVAILABLE", "NOT_INDEPENDENTLY_VERIFIED", "VALID"]
            },
            "certificateChainVerification": { "type": ["string", "null"] },
            "signingCertificateVerification": { "type": ["string", "null"] },
            "revocationVerification": { "enum": ["NOT_CHECKED", "VALID", null] },
            "validatorVersion": { "type": ["string", "null"] },
            "signerCertificateSha256": {
              "type": ["string", "null"],
              "pattern": "^[a-f0-9]{64}$"
            },
            "trustAnchorSha256": {
              "type": ["string", "null"],
              "pattern": "^[a-f0-9]{64}$"
            },
            "token": {
              "type": ["object", "null"],
              "properties": {
                "mediaType": { "const": "application/timestamp-reply" },
                "encoding": { "const": "base64" },
                "sha256": { "$ref": "#/$defs/sha256" }
              }
            }
          }
        },
        "publicChain": {
          "type": "object",
          "required": ["state", "chain", "chainId"],
          "properties": {
            "state": {
              "enum": [
                "NOT_ANCHORED",
                "SUBMITTED",
                "CONFIRMED",
                "FINALIZED",
                "FAILED_ON_CHAIN",
                "INVALID_ON_CHAIN"
              ]
            },
            "chain": { "const": "Ethereum mainnet" },
            "chainId": { "const": 1 },
            "merkleRoot": {
              "type": ["string", "null"],
              "pattern": "^[a-f0-9]{64}$"
            },
            "inclusionPath": { "type": ["array", "null"] },
            "transaction": { "type": ["string", "null"] }
          }
        }
      }
    },
    "proofStatus": {
      "type": "object",
      "required": ["state", "proofsComplete", "alphaComplete", "sealed"],
      "properties": {
        "state": {
          "enum": [
            "EXTERNAL_PROOFS_PENDING",
            "SANDBOX_TIMESTAMP_ISSUED_ANCHOR_PENDING",
            "MAINNET_ANCHORED_QTSP_PENDING",
            "ALPHA_DUAL_RAIL_COMPLETE",
            "DUAL_RAIL_COMPLETE",
            "PUBLIC_ANCHOR_REJECTED"
          ]
        },
        "proofsComplete": { "type": "boolean" },
        "alphaComplete": { "type": "boolean" },
        "sealed": { "type": "boolean" }
      }
    },
    "operationalAudit": { "type": "object" },
    "scope": {
      "type": "object",
      "required": ["proves", "attests", "doesNotProve"]
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "liveCaptureContext": {
      "type": "object",
      "required": [
        "schemaVersion",
        "workflow",
        "challengeId",
        "challengeIssuedAt",
        "challengeCaptureExpiresAt",
        "timeAuthority",
        "capturedAt",
        "location",
        "deviceAttestation",
        "timeAttestation",
        "account"
      ],
      "properties": {
        "schemaVersion": {
          "const": "sitesealed.capture-context.v1.5-alpha.1"
        },
        "workflow": { "const": "WEB_CAMERA_CONTEXT_BOUND_ALPHA" },
        "challengeId": { "type": "string", "format": "uuid" },
        "challengeIssuedAt": { "type": "string", "format": "date-time" },
        "challengeCaptureExpiresAt": { "type": "string", "format": "date-time" },
        "timeAuthority": { "const": "SITESEALED_SERVER_CHALLENGE" },
        "capturedAt": { "type": "string", "format": "date-time" },
        "location": {
          "type": "object",
          "required": [
            "coordinatesManifestBound",
            "measuredAt",
            "accuracyMeters",
            "attestation"
          ],
          "properties": {
            "coordinatesManifestBound": { "const": true },
            "measuredAt": { "type": "string", "format": "date-time" },
            "accuracyMeters": { "type": "number", "minimum": 0 },
            "attestation": {
              "const": "BROWSER_GEOLOCATION_NOT_HARDWARE_ATTESTED"
            }
          }
        },
        "deviceAttestation": { "const": "NOT_AVAILABLE_WEB_ALPHA" },
        "timeAttestation": { "const": "SERVER_CHALLENGE_WINDOW" },
        "account": {
          "type": "object",
          "required": ["provider", "accountReference"],
          "properties": {
            "provider": { "const": "GOOGLE" },
            "accountReference": { "$ref": "#/$defs/sha256" }
          }
        }
      }
    }
  },
  "additionalProperties": true
}
