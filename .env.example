PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# Local development can omit infrastructure and use in-memory adapters.
# Railway must keep required mode so no durable dependency can silently fall
# back to process memory.
DATABASE_MODE=optional
MYSQL_URL=mysql://user:password@localhost:3306/sitesealed
MYSQL_CONNECTION_LIMIT=5

# PostgreSQL stores only the append-only, hash-chained application audit log.
# It is not an eIDAS or public-chain trust anchor.
DATABASE_URL=postgresql://user:password@localhost:5432/sitesealed_audit
POSTGRES_CONNECTION_LIMIT=5

# Redis is non-authoritative: distributed rate limits, short idempotency locks
# and a short-lived cache of already-public verification records only.
REDIS_URL=redis://localhost:6379
VERIFICATION_CACHE_TTL_SECONDS=60

# Private S3-compatible object storage. All five values are required together.
# On Railway, reference the Bucket service variables rather than copying secrets.
S3_ACCESS_KEY=
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=
S3_SECRET_KEY=

# Used in generated verification links and PDF receipts.
PUBLIC_BASE_URL=https://app.sitesealed.com

# Anonymous alpha receipts are deliberately bounded per IP and hour.
SEAL_RATE_LIMIT_PER_HOUR=20

# External rails are strictly opt-in. Keep both disabled in the web service and
# local development. Put live credentials only in the separate Railway cron
# service described in README.md.
EVIDENCY_MODE=disabled
EVIDENCY_API_BASE_URL=https://api-sandbox.evidency.io
EVIDENCY_API_KEY=
EVIDENCY_PROJECT_KEY=
EVIDENCY_TIMEOUT_MS=12000
EVIDENCY_BATCH_SIZE=50
# Alpha.2 safety controls: preview one exact record before the first API call.
EVIDENCY_TARGET_RECORD_ID=
EVIDENCY_DRY_RUN=false
# Defaults to one even if omitted. Raise only after the controlled test passes.
EVIDENCY_MAX_REQUESTS_PER_RUN=1

# WARNING: mainnet mode spends real ETH from a dedicated low-balance wallet.
ETHEREUM_ANCHOR_MODE=disabled
ETHEREUM_RPC_URL=
ETHEREUM_ANCHOR_PRIVATE_KEY=
ETHEREUM_CONFIRMATIONS=12
ETHEREUM_MAX_FEE_GWEI=60
ETHEREUM_GAS_LIMIT=30000
ANCHOR_MAX_BATCH_SIZE=1024
