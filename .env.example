PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# Local development can omit MySQL and use an in-memory store. Railway must
# reference the MySQL service and use required mode.
DATABASE_MODE=optional
MYSQL_URL=mysql://user:password@localhost:3306/sitesealed
MYSQL_CONNECTION_LIMIT=5

# Private S3-compatible object storage. All five values are required together.
# On Railway, reference the Bucket service variables rather than copying secrets.
S3_ACCESS_KEY=
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=
S3_SECRET_KEY=

# Used in generated verification links and PDF receipts.
PUBLIC_BASE_URL=https://app.sitesealed.com

# Anonymous development seals are deliberately bounded per IP and hour.
SEAL_RATE_LIMIT_PER_HOUR=20
