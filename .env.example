PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# Local development may omit MySQL and use the in-memory specimen.
# On Railway, add MYSQL_URL as a reference to ${{MySQL.MYSQL_URL}}
# and set DATABASE_MODE=required.
DATABASE_MODE=optional
MYSQL_URL=mysql://user:password@localhost:3306/sitesealed
MYSQL_CONNECTION_LIMIT=5
